{
  "name": "BackupRecord",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "database",
        "storage",
        "configuration",
        "full"
      ],
      "default": "database"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "in_progress",
        "verified",
        "restored"
      ],
      "default": "completed"
    },
    "size_mb": {
      "type": "number",
      "default": 0
    },
    "duration_ms": {
      "type": "number",
      "default": 0
    },
    "location": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "retention_days": {
      "type": "number",
      "default": 30
    },
    "trigger": {
      "type": "string",
      "enum": [
        "scheduled",
        "manual"
      ],
      "default": "scheduled"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    }
  }
}