{
  "name": "AlertRule",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "metric": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "description": "e.g. '> 5%'"
    },
    "threshold": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "high",
        "critical"
      ],
      "default": "warning"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Notification routing: email, push, in_app, slack, pagerduty."
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "last_triggered": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "metric",
    "severity"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    }
  }
}