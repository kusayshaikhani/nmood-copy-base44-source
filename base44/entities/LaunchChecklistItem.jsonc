{
  "name": "LaunchChecklistItem",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "infrastructure",
        "security",
        "legal",
        "ai",
        "mission_control",
        "monitoring",
        "backups",
        "localization",
        "accessibility",
        "app_store",
        "google_play",
        "notifications",
        "payments",
        "disaster_recovery",
        "launch_day"
      ]
    },
    "item": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked"
      ],
      "default": "pending"
    },
    "owner": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "notes": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "category",
    "item",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    }
  }
}