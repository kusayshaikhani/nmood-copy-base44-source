{
  "name": "ErrorLog",
  "type": "object",
  "properties": {
    "message": {
      "type": "string"
    },
    "stack_trace": {
      "type": "string"
    },
    "screen": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "app_version": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ],
      "default": "error"
    },
    "context": {
      "type": "object",
      "default": {}
    }
  },
  "required": [
    "message",
    "severity"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    }
  }
}