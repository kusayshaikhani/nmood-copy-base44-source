{
  "name": "PalConnection",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "pal_user_id": {
      "type": "string"
    },
    "pal_name": {
      "type": "string"
    },
    "pal_avatar": {
      "type": "string"
    },
    "pal_city": {
      "type": "string"
    },
    "first_experience_title": {
      "type": "string"
    },
    "mutual_experiences_count": {
      "type": "number",
      "default": 1
    },
    "mutual_interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "last_experience_title": {
      "type": "string"
    },
    "last_experience_date": {
      "type": "string"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "connected_date": {
      "type": "string"
    },
    "photos_together": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "pal_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.pal_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "founder"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.pal_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "founder"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.pal_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "founder"
              ]
            }
          }
        }
      ]
    }
  }
}