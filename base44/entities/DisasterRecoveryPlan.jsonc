{
  "name": "DisasterRecoveryPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "rto_target": {
      "type": "string",
      "description": "Recovery Time Objective."
    },
    "rpo_target": {
      "type": "string",
      "description": "Recovery Point Objective."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "testing",
        "retired"
      ],
      "default": "active"
    },
    "emergency_contacts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "runbooks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "backup_strategy": {
      "type": "string"
    },
    "last_tested": {
      "type": "string",
      "format": "date-time"
    },
    "test_result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "pending"
      ],
      "default": "pending"
    }
  },
  "required": [
    "name",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    }
  }
}