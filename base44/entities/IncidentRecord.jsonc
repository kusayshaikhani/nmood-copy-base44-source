{
  "name": "IncidentRecord",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "sev1",
        "sev2",
        "sev3",
        "sev4"
      ],
      "default": "sev3"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "resolved",
        "postmortem",
        "closed"
      ],
      "default": "open"
    },
    "subsystem": {
      "type": "string"
    },
    "assignee": {
      "type": "string"
    },
    "assignee_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "root_cause": {
      "type": "string"
    },
    "postmortem": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "severity",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    }
  }
}