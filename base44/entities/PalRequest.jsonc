{
  "name": "PalRequest",
  "type": "object",
  "properties": {
    "sender_user_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_avatar": {
      "type": "string"
    },
    "receiver_user_id": {
      "type": "string"
    },
    "receiver_name": {
      "type": "string"
    },
    "receiver_avatar": {
      "type": "string"
    },
    "experience_id": {
      "type": "string",
      "description": "Canonical Experience entity ID (hex string). Never parseInt \u2014 the Experience ID is a MongoDB ObjectID string."
    },
    "experience_title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "cancelled"
      ],
      "default": "pending",
      "description": "Connection request status. Server-controlled via backend actions (acceptConnection, rejectConnection, cancelConnectionRequest). Direct client updates are blocked by RLS."
    },
    "mutual_interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "message": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "incoming",
        "outgoing"
      ],
      "default": "outgoing"
    }
  },
  "required": [
    "sender_name",
    "receiver_name",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.receiver_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder"
          }
        }
      ]
    }
  }
}