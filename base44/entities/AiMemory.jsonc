{
  "name": "AiMemory",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string",
      "description": "Member user id this memory belongs to."
    },
    "domain": {
      "type": "string",
      "enum": [
        "interest",
        "preference",
        "behavioral",
        "conversation",
        "mood"
      ],
      "description": "Independent memory domain."
    },
    "key": {
      "type": "string",
      "description": "Memory key e.g. 'interest:photography', 'preference:group_size'."
    },
    "value": {
      "type": "string",
      "description": "Remembered value."
    },
    "weight": {
      "type": "number",
      "default": 1,
      "description": "Affinity / frequency weight."
    },
    "consent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the member consented to this memory being used."
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "connections",
        "public"
      ],
      "default": "private"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Automatic expiration timestamp."
    },
    "source": {
      "type": "string",
      "description": "How the memory was derived (onboarding, behavior, explicit)."
    },
    "editable": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "member_id",
    "domain",
    "key",
    "value"
  ],
  "rls": {
    "create": {
      "data.member_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.member_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "founder"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.member_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "founder"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.member_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "founder"
              ]
            }
          }
        }
      ]
    }
  }
}