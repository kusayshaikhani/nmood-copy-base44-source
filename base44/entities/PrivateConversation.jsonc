{
  "name": "PrivateConversation",
  "type": "object",
  "properties": {
    "pair_key": {
      "type": "string",
      "description": "Deterministic sorted 'lowId:highId' pair key \u2014 guarantees one conversation per member pair (dedupe)."
    },
    "participant_a_id": {
      "type": "string",
      "description": "Lower-sorted participant user id (queryable)."
    },
    "participant_b_id": {
      "type": "string",
      "description": "Higher-sorted participant user id (queryable)."
    },
    "participant_a_name": {
      "type": "string"
    },
    "participant_b_name": {
      "type": "string"
    },
    "participant_a_avatar": {
      "type": "string"
    },
    "participant_b_avatar": {
      "type": "string"
    },
    "last_message": {
      "type": "string",
      "default": ""
    },
    "last_message_type": {
      "type": "string",
      "default": "text"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "unread_a": {
      "type": "number",
      "default": 0
    },
    "unread_b": {
      "type": "number",
      "default": 0
    },
    "typing_user_id": {
      "type": "string"
    },
    "typing_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "pair_key"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.participant_a_id": "{{user.id}}"
        },
        {
          "data.participant_b_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.participant_a_id": "{{user.id}}"
        },
        {
          "data.participant_b_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "founder"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.participant_a_id": "{{user.id}}"
        },
        {
          "data.participant_b_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "founder"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.participant_a_id": "{{user.id}}"
        },
        {
          "data.participant_b_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "founder"
              ]
            }
          }
        }
      ]
    }
  }
}