{
  "name": "CommunityMessage",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "number"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_avatar": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "moderator",
        "member"
      ],
      "default": "member"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "photo",
        "announcement",
        "poll",
        "event"
      ],
      "default": "text"
    },
    "content": {
      "type": "string"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "community_id",
    "sender_name",
    "type",
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "founder"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "founder"
              ]
            }
          }
        }
      ]
    }
  }
}