{
  "name": "AiExecution",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Standardized request id generated by the orchestrator."
    },
    "ai_service": {
      "type": "string",
      "description": "Service id from the AI Service Registry."
    },
    "service_category": {
      "type": "string",
      "description": "Intelligence category the service belongs to."
    },
    "provider": {
      "type": "string",
      "description": "Logical provider used (automatic/openai/anthropic/gemini/azure/local)."
    },
    "model": {
      "type": "string",
      "description": "Resolved model identifier passed to the LLM integration."
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "member_id": {
      "type": "string",
      "description": "Member id when the request is member-scoped."
    },
    "session_id": {
      "type": "string",
      "description": "Session id for request correlation."
    },
    "language": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "processing_time_ms": {
      "type": "number",
      "default": 0
    },
    "confidence_score": {
      "type": "number",
      "default": 0,
      "description": "0\u20131 confidence reported with the response."
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "timeout",
        "safety_block",
        "invalid_response",
        "unavailable"
      ],
      "default": "success"
    },
    "safety_status": {
      "type": "string",
      "enum": [
        "safe",
        "flagged",
        "blocked"
      ],
      "default": "safe"
    },
    "error_type": {
      "type": "string",
      "description": "Standardized error type when status is not success."
    },
    "response_summary": {
      "type": "string",
      "description": "Short reasoning / outcome summary."
    },
    "accepted": {
      "type": "boolean",
      "default": false,
      "description": "Whether a recommendation result was accepted by the member."
    },
    "context": {
      "type": "object",
      "default": {},
      "description": "Non-sensitive request context summary."
    }
  },
  "required": [
    "request_id",
    "ai_service",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    }
  }
}