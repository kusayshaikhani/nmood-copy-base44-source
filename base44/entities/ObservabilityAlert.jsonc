{
  "name": "ObservabilityAlert",
  "type": "object",
  "properties": {
    "alert_id": {
      "type": "string",
      "description": "Stable id used to dedupe repeated alerts for the same metric."
    },
    "level": {
      "type": "string",
      "enum": [
        "informational",
        "warning",
        "high",
        "critical"
      ],
      "default": "warning"
    },
    "title": {
      "type": "string"
    },
    "metric": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "threshold": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "resolved"
      ],
      "default": "open"
    },
    "acknowledged_by": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "string"
    }
  },
  "required": [
    "alert_id",
    "level",
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "founder"
          ]
        }
      }
    }
  }
}